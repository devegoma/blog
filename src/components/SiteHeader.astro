---
interface Props {
    active?: "articles" | "tags" | "about";
}
const { active = "articles" } = Astro.props;
---

<header class="site-header">
    <div class="home-shell">
        <div class="masthead">
            <a class="wordmark" href="/" aria-label="devegoma’s blog ホーム">
                devegoma<span>’</span>s blog
            </a>
            <div class="header-actions">
                <div class="desktop-search" role="search" aria-label="記事検索">
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                        <circle cx="10.5" cy="10.5" r="7" />
                        <path d="m16 16 5 5" />
                    </svg>
                    <input
                        type="search"
                        aria-label="記事を検索（準備中）"
                        placeholder="検索は準備中"
                        disabled
                    />
                </div>
                <button
                    class="search-open icon-link"
                    type="button"
                    aria-label="検索を開く"
                    aria-haspopup="dialog"
                    aria-controls="article-search"
                    data-search-open
                    hidden
                >
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                        <circle cx="10.5" cy="10.5" r="7" />
                        <path d="m16 16 5 5" />
                    </svg>
                </button>
                <button
                    class="theme-toggle icon-link"
                    type="button"
                    data-theme-toggle
                    aria-label="ダークモードに切り替える"
                    hidden
                >
                    <svg
                        class="moon-icon"
                        viewBox="0 0 24 24"
                        aria-hidden="true"
                    >
                        <path
                            d="M20 15.5A8.5 8.5 0 0 1 8.5 4 8.5 8.5 0 1 0 20 15.5Z"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="1.8"
                        />
                    </svg>
                    <svg
                        class="sun-icon"
                        viewBox="0 0 24 24"
                        aria-hidden="true"
                    >
                        <circle
                            cx="12"
                            cy="12"
                            r="4"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="1.8"
                        />
                        <path
                            d="M12 1v3m0 16v3M1 12h3m16 0h3M4 4l2 2m12 12 2 2M4 20l2-2M18 6l2-2"
                            stroke="currentColor"
                            stroke-width="1.8"
                        />
                    </svg>
                </button>
            </div>
        </div>
        <nav class="main-nav" aria-label="メイン">
            <a
                href="/"
                aria-current={active === "articles" ? "page" : undefined}
            >
                記事
            </a>
            <a
                href="/tags/"
                aria-current={active === "tags" ? "page" : undefined}
            >
                タグ
            </a>
            <a
                href="/about/"
                aria-current={active === "about" ? "page" : undefined}
            >
                このブログについて
            </a>
        </nav>
    </div>
</header>
<dialog
    id="article-search"
    class="search-dialog"
    aria-labelledby="search-title"
    aria-describedby="search-note"
>
    <h2 id="search-title">記事検索</h2>
    <p id="search-note">検索は準備中です。記事を探す機能は今後追加します。</p>
    <input
        type="search"
        aria-label="記事を検索（準備中）"
        placeholder="検索は準備中"
        disabled
    />
    <form method="dialog">
        <button class="search-close" autofocus>
            閉じる
        </button>
    </form>
</dialog>
