---
import HomeLayout from "../layouts/HomeLayout.astro";

// 表示確認用データ。本番の記事管理・タグ機能とは別に扱う。
const posts = [
    {
        title: "読書メモを、あとから使える形にする",
        date: "2026-10-28",
        tag: "Obsidian",
        description:
            "読んだ内容を、時間が経っても思い出せるように。自分なりの方法と、実際のメモの例を紹介します。",
        minutes: 5,
        image: "reading",
        href: "/posts/sample/",
    },
    {
        title: "小さな自動化を試した記録",
        date: "2026-10-21",
        tag: "TypeScript",
        description:
            "毎日の作業で繰り返ししていた手順を見直す。使ったツールと、試してわかったことを残します。",
        minutes: 4,
        image: "tools",
    },
    {
        title: "コードを書く前に、考えておきたいこと",
        date: "2026-10-14",
        tag: "Astro",
        description:
            "実装の前に整理しておくと、あとで楽になること。小さなプロジェクトで意識したいポイントをまとめました。",
        minutes: 6,
        image: "planning",
    },
];
---

<HomeLayout>
    <div class="home-shell">
        <header class="masthead">
            <a class="wordmark" href="/" aria-label="devegoma’s blog ホーム">
                devegoma<span>’</span>s blog
            </a>
        </header>
        <div class="home-grid">
            <section class="profile panel" aria-labelledby="profile-name">
                <div class="avatar" aria-hidden="true">
                    d
                </div>
                <div class="profile-content">
                    <h2 id="profile-name">devegoma</h2>
                    <p>
                        読んだ本、試した道具。
                        <br />
                        日々の学びを記録しています。
                    </p>
                    <div class="socials">
                        <span
                            class="icon-link"
                            role="link"
                            aria-label="RSS（準備中）"
                            aria-disabled="true"
                        >
                            <svg viewBox="0 0 24 24" aria-hidden="true">
                                <circle
                                    cx="5"
                                    cy="19"
                                    r="2"
                                    fill="currentColor"
                                />
                                <path
                                    d="M3 10a11 11 0 0 1 11 11M3 3a18 18 0 0 1 18 18"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="3"
                                />
                            </svg>
                        </span>
                        <a
                            class="icon-link"
                            href="https://github.com/devegoma"
                            aria-label="GitHub"
                        >
                            <svg viewBox="0 0 24 24" aria-hidden="true">
                                <path
                                    fill="currentColor"
                                    d="M12 .75a11.25 11.25 0 0 0-3.56 21.92c.56.1.77-.24.77-.54v-2.1c-3.13.68-3.79-1.33-3.79-1.33-.51-1.3-1.25-1.65-1.25-1.65-1.02-.7.08-.68.08-.68 1.13.08 1.73 1.16 1.73 1.16 1 1.72 2.63 1.22 3.27.93.1-.73.39-1.22.72-1.5-2.5-.29-5.13-1.25-5.13-5.56 0-1.23.44-2.23 1.16-3.02-.12-.28-.5-1.43.11-2.98 0 0 .95-.3 3.1 1.15a10.8 10.8 0 0 1 5.64 0c2.15-1.45 3.1-1.15 3.1-1.15.61 1.55.23 2.7.11 2.98.72.79 1.16 1.79 1.16 3.02 0 4.32-2.63 5.27-5.14 5.55.4.35.76 1.04.76 2.1v3.08c0 .3.2.65.77.54A11.25 11.25 0 0 0 12 .75Z"
                                />
                            </svg>
                        </a>
                        <a
                            class="icon-link"
                            href="https://x.com/devegoma"
                            aria-label="X"
                        >
                            <svg viewBox="0 0 24 24" aria-hidden="true">
                                <path
                                    d="m4 3 16 18h-4L0 3h4Zm16 0L4 21"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="1.5"
                                    transform="translate(2 0) scale(.9 1)"
                                />
                            </svg>
                        </a>
                    </div>
                </div>
            </section>
            <nav class="main-nav panel" aria-label="メイン">
                <a href="/" aria-current="page">
                    記事
                </a>
                <span role="link" aria-disabled="true">
                    タグ
                </span>
                <span role="link" aria-disabled="true">
                    <span class="nav-desktop">このブログについて</span>
                    <span class="nav-mobile">紹介</span>
                </span>
            </nav>
            <section class="preferences" aria-label="タグと表示設定">
                <div class="tags panel">
                    <h2>タグ</h2>
                    <div class="tag-list">
                        {["TypeScript", "Astro", "Obsidian"].map((tag) => (
                            <span class="tag" role="link" aria-disabled="true">
                                {tag}
                            </span>
                        ))}
                    </div>
                </div>
                <button
                    class="theme-toggle icon-link"
                    type="button"
                    data-theme-toggle
                    aria-label="ダークモードに切り替える"
                    hidden
                >
                    <svg
                        class="moon-icon"
                        viewBox="0 0 24 24"
                        aria-hidden="true"
                    >
                        <path
                            d="M20 15.5A8.5 8.5 0 0 1 8.5 4 8.5 8.5 0 1 0 20 15.5Z"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="1.8"
                        />
                    </svg>
                    <svg
                        class="sun-icon"
                        viewBox="0 0 24 24"
                        aria-hidden="true"
                    >
                        <circle
                            cx="12"
                            cy="12"
                            r="4"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="1.8"
                        />
                        <path
                            d="M12 1v3m0 16v3M1 12h3m16 0h3M4 4l2 2m12 12 2 2M4 20l2-2M18 6l2-2"
                            stroke="currentColor"
                            stroke-width="1.8"
                        />
                    </svg>
                </button>
            </section>
            <main class="articles-column" id="articles">
                <div class="list-heading">
                    <h1>最近の記録</h1>
                    <span>新しい順</span>
                </div>
                <div class="article-list">
                    {posts.map((post) => (
                        <article>
                            <div class="article-copy">
                                <div class="post-meta">
                                    <time datetime={post.date}>
                                        {post.date.replaceAll("-", ".")}
                                    </time>
                                    <span>{post.tag}</span>
                                </div>
                                <h2>
                                    {post.href ? (
                                        <a href={post.href}>{post.title}</a>
                                    ) : (
                                        post.title
                                    )}
                                </h2>
                                <p>{post.description}</p>
                                <p class="reading-time">
                                    {post.minutes}分で読めます
                                </p>
                            </div>
                            <img
                                class="thumbnail"
                                src={`/images/sample-${post.image}.png`}
                                alt=""
                                width="1672"
                                height="941"
                                loading="lazy"
                            />
                        </article>
                    ))}
                </div>
                <span class="all-posts" role="link" aria-disabled="true">
                    すべての記事を見る <span aria-hidden="true">→</span>
                </span>
            </main>
        </div>
    </div>
    <footer class="home-footer">
        <span>© devegoma</span>
        <small>
            開発用サンプル · プロフィール・記事・画像は表示確認用です。
        </small>
    </footer>
</HomeLayout>
