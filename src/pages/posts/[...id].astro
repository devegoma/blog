---
import { render } from "astro:content";
import type { InferGetStaticPropsType } from "astro";
import Layout from "../../layouts/Layout.astro";
import { getPosts } from "../../data/posts";
import ArticleTable from "../../components/ArticleTable.astro";
import CodeBlock from "../../components/CodeBlock.astro";

export async function getStaticPaths() {
    const posts = await getPosts({ includeDrafts: import.meta.env.DEV });
    const published = posts.filter((post) => !post.draft);
    return posts.map((post) => {
        const index = published.findIndex((entry) => entry.id === post.id);
        return {
            params: { id: post.id },
            props: {
                post,
                previous: index >= 0 ? published[index + 1] : undefined,
                next: index >= 0 ? published[index - 1] : undefined,
            },
        };
    });
}
type Props = InferGetStaticPropsType<typeof getStaticPaths>;
const { post, previous, next } = Astro.props;
const { Content, headings } = await render(post.entry);
---

<Layout post={post} headings={headings} previous={previous} next={next}>
    <Content components={{ table: ArticleTable, pre: CodeBlock }} />
</Layout>
