---
import "../styles/global.css";
import { formatPageTitle } from "../utils/page-title.mjs";

interface Props {
    title: string;
}

const { title } = Astro.props;
const pageTitle = formatPageTitle(title);
---

<!doctype html>
<html lang="ja">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>{pageTitle}</title>
    </head>
    <body class="bg-white text-slate-900">
        <div class="mx-auto max-w-3xl px-6 py-10 leading-8">
            <header class="mb-10">
                <a class="underline" href="/">
                    devegoma's blog
                </a>
            </header>
            <main>
                <slot />
            </main>
        </div>
    </body>
</html>
