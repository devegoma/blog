---
import type { MarkdownHeading } from "astro";
import HomeLayout from "./HomeLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import Profile from "../components/Profile.astro";
import TableOfContents from "../components/TableOfContents.astro";
import { tagLabel } from "../data/tags";
import { tagHref, type getPosts } from "../data/posts";
import "../styles/article.css";

interface Props {
    post: Awaited<ReturnType<typeof getPosts>>[number];
    headings: MarkdownHeading[];
    previous?: Pick<
        Awaited<ReturnType<typeof getPosts>>[number],
        "title" | "href"
    >;
    next?: Pick<Awaited<ReturnType<typeof getPosts>>[number], "title" | "href">;
}
const { post, headings, previous, next } = Astro.props;
const toc = headings.filter(
    (heading) => heading.depth === 2 || heading.depth === 3,
);
const dateLabel = (date: string) => date.replaceAll("-", ".");
---

<HomeLayout
    title={post.title}
    description={post.description}
    mainId="article-content"
    skipLabel="記事本文へ移動"
>
    <SiteHeader />
    <div class="home-shell article-shell">
        <nav class="article-breadcrumb" aria-label="パンくず">
            <a href="/">記事一覧</a>
            <span aria-hidden="true">/</span>
            <span aria-current="page">{post.title}</span>
        </nav>
        <div class="article-grid">
            <div class="article-author">
                <Profile />
            </div>
            <main
                id="article-content"
                tabindex="-1"
                aria-labelledby="article-title"
            >
                <article class="article-paper panel">
                    {!post.draft && (
                        <nav class="article-pagination" aria-label="前後の記事">
                            {next ? (
                                <a
                                    href={next.href}
                                    rel="next"
                                    title={next.title}
                                    class="article-next"
                                >
                                    <span class="article-pagination-label">
                                        ← 次の記事
                                    </span>
                                    <span class="article-pagination-title">
                                        {next.title}
                                    </span>
                                </a>
                            ) : (
                                <div class="article-next article-pagination-empty">
                                    <span>最新の記事です</span>
                                </div>
                            )}
                            <a href="/" class="article-index">
                                記事一覧
                            </a>
                            {previous ? (
                                <a
                                    href={previous.href}
                                    rel="prev"
                                    title={previous.title}
                                    class="article-previous"
                                >
                                    <span class="article-pagination-label">
                                        前の記事 →
                                    </span>
                                    <span class="article-pagination-title">
                                        {previous.title}
                                    </span>
                                </a>
                            ) : (
                                <div class="article-previous article-pagination-empty">
                                    <span>最後の記事です</span>
                                </div>
                            )}
                        </nav>
                    )}
                    <header class="article-heading">
                        {post.draft && (
                            <p class="draft-notice">
                                下書き · 開発プレビュー限定
                            </p>
                        )}
                        <h1 id="article-title">{post.title}</h1>
                        <div class="article-meta">
                            {post.date && (
                                <span>
                                    公開{" "}
                                    <time datetime={post.date}>
                                        {dateLabel(post.date)}
                                    </time>
                                </span>
                            )}
                            {post.updated && (
                                <span>
                                    更新{" "}
                                    <time datetime={post.updated}>
                                        {dateLabel(post.updated)}
                                    </time>
                                </span>
                            )}
                            <span>{post.minutes}分で読めます</span>
                        </div>
                        {post.tags.length > 0 && (
                            <div
                                class="tag-list article-tags"
                                aria-label="記事のタグ"
                            >
                                {post.tags.map((tag) => (
                                    <a class="tag" href={tagHref(tag)}>
                                        {tagLabel(tag)}
                                    </a>
                                ))}
                            </div>
                        )}
                    </header>
                    {toc.length > 0 && (
                        <details class="mobile-toc panel">
                            <summary>
                                目次 <span>{toc.length}項目</span>
                                <span class="toc-chevron" aria-hidden="true">
                                    ⌄
                                </span>
                            </summary>
                            <TableOfContents
                                headings={toc}
                                label="モバイル目次"
                            />
                        </details>
                    )}
                    <div class="article-body">
                        <slot />
                    </div>
                    <footer class="article-end">
                        <a href="/">← 記事一覧に戻る</a>
                    </footer>
                </article>
            </main>
            {toc.length > 0 && (
                <aside class="article-toc panel" aria-labelledby="toc-title">
                    <h2 id="toc-title">目次</h2>
                    <TableOfContents headings={toc} label="目次" />
                </aside>
            )}
        </div>
    </div>
    <footer class="home-footer">
        <span>© devegoma</span>
        <small>開発用サンプル · 記事・画像は表示確認用です。</small>
    </footer>
</HomeLayout>

<script>
    const links = [...document.querySelectorAll<HTMLAnchorElement>(".toc a")];
    const headings = [
        ...document.querySelectorAll<HTMLElement>(
            ".article-body h2, .article-body h3",
        ),
    ];
    let scheduled = false;
    let anchorSelection: { heading: HTMLElement; scrollY: number } | undefined;
    const update = () => {
        // Keep a clicked heading selected even when its anchor scroll is clamped.
        if (
            anchorSelection &&
            Math.abs(window.scrollY - anchorSelection.scrollY) > 1
        )
            anchorSelection = undefined;
        // A short final section may never reach the normal heading threshold.
        const atBottom =
            window.scrollY > 0 &&
            window.scrollY + window.innerHeight >=
                document.documentElement.scrollHeight - 1;
        const scrollLimit = Math.max(
            0,
            document.documentElement.scrollHeight - window.innerHeight,
        );
        const offsets = headings.map((heading) =>
            Math.max(
                0,
                heading.getBoundingClientRect().top + window.scrollY - 160,
            ),
        );
        const lastOffset = offsets.at(-1) ?? 0;
        // Fit otherwise unreachable trailing headings into the remaining scroll range.
        const tailStart =
            offsets.findLast((offset) => offset < scrollLimit) ?? 0;
        const tailScale =
            lastOffset > scrollLimit && scrollLimit > tailStart
                ? (scrollLimit - tailStart) / (lastOffset - tailStart)
                : 1;
        const current =
            anchorSelection?.heading ??
            (atBottom
                ? headings.at(-1)
                : (headings.findLast((_, index) => {
                      const offset = offsets[index];
                      const trigger =
                          offset > tailStart
                              ? tailStart + (offset - tailStart) * tailScale
                              : offset;
                      return trigger <= window.scrollY + 1;
                  }) ?? headings[0]));
        for (const link of links) {
            if (
                current &&
                decodeURIComponent(link.hash.slice(1)) === current.id
            )
                link.setAttribute("aria-current", "location");
            else link.removeAttribute("aria-current");
        }
        scheduled = false;
    };
    const selectHashTarget = () => {
        const link = links.find((link) => link.hash === window.location.hash);
        const heading =
            link &&
            headings.find(
                (heading) =>
                    heading.id === decodeURIComponent(link.hash.slice(1)),
            );
        anchorSelection = heading
            ? { heading, scrollY: window.scrollY }
            : undefined;
        update();
    };
    for (const link of links) {
        link.addEventListener("click", (event) => {
            if (
                event.defaultPrevented ||
                event.button !== 0 ||
                event.ctrlKey ||
                event.metaKey ||
                event.shiftKey ||
                event.altKey
            )
                return;
            const heading = headings.find(
                (heading) =>
                    heading.id === decodeURIComponent(link.hash.slice(1)),
            );
            if (!heading) return;
            event.preventDefault();
            // Native same-hash scrolling can finish after a frame in Firefox.
            // Complete the jump before recording the position used by scroll tracking.
            heading.scrollIntoView({ behavior: "instant", block: "start" });
            if (window.location.hash !== link.hash)
                window.history.pushState(null, "", link.hash);
            heading.tabIndex = -1;
            heading.focus({ preventScroll: true });
            selectHashTarget();
        });
    }
    window.addEventListener("hashchange", () =>
        requestAnimationFrame(selectHashTarget),
    );
    window.addEventListener("load", () =>
        requestAnimationFrame(selectHashTarget),
    );
    window.addEventListener(
        "scroll",
        () => {
            if (!scheduled) {
                scheduled = true;
                requestAnimationFrame(update);
            }
        },
        { passive: true },
    );
    window.addEventListener("resize", update);
    selectHashTarget();
</script>
