---
import "../styles/global.css";
import "../styles/home.css";
import { formatPageTitle } from "../utils/page-title.mjs";

interface Props {
    title?: string;
    description?: string;
    type?: "website" | "article";
    noindex?: boolean;
    mainId?: string;
    skipLabel?: string;
}
const {
    title = "記事",
    description = "読んだ本、試した道具。日々の学びを記録する devegoma の個人ブログ。",
    noindex = false,
    type = "website",
    mainId = "articles",
    skipLabel = "記事一覧へ移動",
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const socialTitle = type === "article" ? title : formatPageTitle(title);
const socialImage = new URL("/images/social-share.png", Astro.site);
---

<!doctype html>
<html lang="ja">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="description" content={description} />
        <title>{formatPageTitle(title)}</title>
        {noindex ? (
            <meta name="robots" content="noindex" />
        ) : (
            <link rel="canonical" href={canonical} />
        )}
        {!noindex && (
            <>
                <meta property="og:type" content={type} />
                <meta property="og:title" content={socialTitle} />
                <meta property="og:description" content={description} />
                <meta property="og:url" content={canonical} />
                <meta property="og:site_name" content="devegoma's blog" />
                <meta property="og:image" content={socialImage} />
                <meta property="og:image:alt" content="devegoma's blog" />
                <meta name="twitter:card" content="summary_large_image" />
                <meta name="twitter:title" content={socialTitle} />
                <meta name="twitter:description" content={description} />
                <meta name="twitter:image" content={socialImage} />
                <meta name="twitter:image:alt" content="devegoma's blog" />
            </>
        )}
        <link
            rel="alternate"
            type="application/rss+xml"
            title="devegoma's blog"
            href={new URL("/rss.xml", Astro.site)}
        />
        <script is:inline>
            (() => {
                const media = matchMedia("(prefers-color-scheme: dark)");
                let preference;
                try {
                    const saved = localStorage.getItem("color-theme");
                    if (saved === "light" || saved === "dark")
                        preference = saved;
                } catch {
                    /* 保存不可でも OS 設定と画面内の操作を使用する。 */
                }
                const apply = () => {
                    const theme =
                        preference || (media.matches ? "dark" : "light");
                    document.documentElement.dataset.theme = theme;
                    document.documentElement.style.colorScheme = theme;
                    const button = document.querySelector(
                        "[data-theme-toggle]",
                    );
                    if (button)
                        button.setAttribute(
                            "aria-label",
                            theme === "dark"
                                ? "ライトモードに切り替える"
                                : "ダークモードに切り替える",
                        );
                };
                apply();
                media.addEventListener("change", () => {
                    if (!preference) apply();
                });
                document.addEventListener("DOMContentLoaded", () => {
                    apply();
                    const button = document.querySelector(
                        "[data-theme-toggle]",
                    );
                    if (!button) return;
                    button.hidden = false;
                    button.addEventListener("click", () => {
                        preference =
                            document.documentElement.dataset.theme === "dark"
                                ? "light"
                                : "dark";
                        try {
                            localStorage.setItem("color-theme", preference);
                        } catch {
                            /* 操作自体は継続する。 */
                        }
                        apply();
                    });
                    const searchButton =
                        document.querySelector("[data-search-open]");
                    const searchDialog =
                        document.getElementById("article-search");
                    if (
                        searchButton &&
                        searchDialog instanceof HTMLDialogElement
                    ) {
                        searchButton.hidden = false;
                        searchButton.addEventListener("click", () =>
                            searchDialog.showModal(),
                        );
                    }
                });
            })();
        </script>
    </head>
    <body class="home-page">
        <a class="skip-link" href={`#${mainId}`}>
            {skipLabel}
        </a>
        <slot />
    </body>
</html>
