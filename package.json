{
    "name": "devegoma-blog",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "packageManager": "pnpm@12.16.1",
    "engines": {
        "node": "24.22.1",
        "pnpm": "12.16.1"
    },
    "scripts": {
        "dev": "astro dev",
        "build": "astro build",
        "preview": "astro preview",
        "dev:verification": "node scripts/run-astro-verification.mjs dev",
        "build:verification": "node scripts/run-astro-verification.mjs build",
        "preview:verification": "node scripts/run-astro-verification.mjs preview",
        "lint": "eslint . --max-warnings 0",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "check": "astro check",
        "test": "pnpm test:unit && pnpm test:content && pnpm test:rss && pnpm test:publication && pnpm test:drafts && pnpm test:tags && pnpm test:home && pnpm test:sitemap && pnpm test:search-metadata && pnpm test:social-metadata && pnpm test:build-targets && pnpm build && pnpm test:search-artifacts && pnpm build:verification && node scripts/check-search-artifacts.mjs dist-verification && playwright test",
        "test:home": "node scripts/check-home.mjs",
        "test:content": "node scripts/check-content.mjs",
        "test:rss": "node scripts/check-rss.mjs",
        "test:sitemap": "node scripts/check-sitemap.mjs",
        "test:search-metadata": "node scripts/check-search-metadata.mjs",
        "test:social-metadata": "node scripts/check-social-metadata.mjs",
        "test:search-artifacts": "node scripts/check-search-artifacts.mjs",
        "test:publication": "node scripts/check-publication.mjs",
        "test:tags": "node scripts/check-tag-data.mjs && node scripts/check-tags.mjs",
        "test:unit": "node --test unit-tests/*.test.mjs",
        "test:ui": "playwright test --ui",
        "test:drafts": "node scripts/check-draft-preview.mjs",
        "test:build-targets": "node scripts/check-build-targets.mjs"
    },
    "dependencies": {
        "@astrojs/mdx": "8.1.3",
        "@astrojs/rss": "4.0.19",
        "@tailwindcss/vite": "4.3.5",
        "astro": "7.4.7",
        "satteri": "0.11.7",
        "tailwindcss": "4.3.5"
    },
    "devDependencies": {
        "@astrojs/check": "0.9.12",
        "@playwright/test": "1.65.0",
        "@types/node": "24.19.2",
        "eslint": "10.14.0",
        "eslint-config-prettier": "10.1.8",
        "eslint-plugin-astro": "3.2.1",
        "prettier": "3.9.10",
        "prettier-plugin-astro": "1.1.2",
        "prettier-plugin-tailwindcss": "0.8.1",
        "sax": "1.6.1",
        "typescript": "6.0.3",
        "typescript-eslint": "8.72.1"
    }
}
