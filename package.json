{
    "name": "devegoma-blog",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "packageManager": "pnpm@12.16.1",
    "engines": {
        "node": "24.22.1",
        "pnpm": "12.16.1"
    },
    "scripts": {
        "dev": "astro dev",
        "build": "astro build",
        "preview": "astro preview",
        "lint": "eslint . --max-warnings 0",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "check": "astro check",
        "test": "pnpm test:unit && pnpm test:publication && pnpm build && playwright test",
        "test:publication": "node scripts/check-publication.mjs",
        "test:unit": "node --test unit-tests/page-title.test.mjs",
        "test:ui": "playwright test --ui"
    },
    "dependencies": {
        "@astrojs/mdx": "8.1.1",
        "@tailwindcss/vite": "4.3.3",
        "astro": "7.4.2",
        "tailwindcss": "4.3.3"
    },
    "devDependencies": {
        "@astrojs/check": "0.9.12",
        "@playwright/test": "1.64.1",
        "@types/node": "24.19.2",
        "eslint": "10.13.0",
        "eslint-config-prettier": "10.1.8",
        "eslint-plugin-astro": "3.2.1",
        "prettier": "3.9.10",
        "prettier-plugin-astro": "1.1.2",
        "prettier-plugin-tailwindcss": "0.8.1",
        "typescript": "6.0.3",
        "typescript-eslint": "8.72.1"
    }
}
